<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Findings describe someone's private search of a room. They never leave
         the device, and they are not written into a cloud or device-transfer
         backup either. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
